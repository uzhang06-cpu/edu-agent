# =============================================
# 🔑 DeepSeek API 密钥配置
# =============================================
# 1. 复制此文件并重命名为 .env
# 2. 将下方 your_deepseek_api_key_here 替换为你的真实 API Key
# 3. DeepSeek API Key 获取地址: https://platform.deepseek.com/api_keys
#
# ⚠️ 重要提示:
#    - .env 文件绝对不要上传到 Git / 公开仓库
#    - 已在 .gitignore 中排除 .env

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 服务端口 (可选, 默认 3000)
PORT=3000

# 学校/机构名称 (显示在 Agent 中)
SCHOOL_NAME=星光教育

# MongoDB Atlas 连接字符串
MONGODB_URI=mongodb+srv://用户名:密码@cluster0.xxxx.mongodb.net/?appName=Cluster0

# JWT 签名密钥（设置一个随机长字符串）
JWT_SECRET=your_random_secret_here

# =============================================
# 🔍 联网搜索（可选，但强烈推荐配置）
# =============================================
# Tavily API（免费 1000 次/月，不需要信用卡）
# 获取地址: https://app.tavily.com/  注册后在 Dashboard 取 API Key
# 部署在云端时，Tavily 是最稳定的通道（DuckDuckGo 经常封云 IP）
TAVILY_API_KEY=

# =============================================
# 📚 课程套餐配置 (JSON格式, 可自定义)
# =============================================
COURSE_PACKAGES=[{"name":"基础班","price":2980,"duration":"3个月","features":["每周4节直播课","课后作业批改","学习群答疑"]},{"name":"精英班","price":5980,"duration":"6个月","features":["每周6节直播课","1对1月度辅导","专属学习顾问","优先排课权益"]},{"name":"VIP定制班","price":12800,"duration":"12个月","features":["无限次直播回放","每周1对1专属课","全年学习规划","就业/升学指导","终身学员社区"]}]
